<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DASH CRASH PAD 🎛️ — The Constellation of the ʻOhana</title>
<meta name="description" content="Every dashboard Shaka and the agent ʻohana have built on Taurus — one constellation map. Dash catch 'em all.">
<meta http-equiv="Cache-Control" content="no-cache, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600;9..144,900&family=Space+Grotesk:wght@300;400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#07050e;
  --ink2:#0d0918;
  --ink3:#150e26;
  --gold:#f0c464;
  --gold2:#e8b04b;
  --violet:#8b5cf6;
  --violet2:#a78bfa;
  --coral:#ff8a5c;
  --rose:#e86a92;
  --teal:#4fc3b1;
  --cream:#f9f0dd;
  --dim:#9a8fb8;
  --card:rgba(21,14,38,.72);
  --line:rgba(240,196,100,.14);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--ink);
  color:var(--cream);
  font-family:'Space Grotesk',system-ui,sans-serif;
  overflow-x:hidden;
  line-height:1.6;
}
::selection{background:var(--gold);color:var(--ink)}
#stars{position:fixed;inset:0;z-index:0;pointer-events:none}
.wrap{position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:0 24px}

/* ---------- HERO ---------- */
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:80px 24px 60px;position:relative}
.eyebrow{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.35em;text-transform:uppercase;color:var(--gold);margin-bottom:22px;opacity:.9}
h1.title{
  font-family:'Fraunces',serif;font-weight:900;
  font-size:clamp(52px,10vw,124px);line-height:.95;letter-spacing:-.02em;
  background:linear-gradient(115deg,var(--cream) 10%,var(--gold) 45%,var(--violet2) 80%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin-bottom:8px;
}
.tagline{font-family:'Fraunces',serif;font-style:italic;font-weight:300;font-size:clamp(18px,2.6vw,26px);color:var(--dim);max-width:640px;margin:18px auto 0}
.tagline b{color:var(--coral);font-weight:600;font-style:normal}
.catchline{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--gold);margin-top:26px;letter-spacing:.08em}
.catchline span{opacity:.55;margin:0 10px}

/* ---------- FORK ---------- */
.forkhero{display:inline-flex;align-items:center;gap:12px;margin-top:34px;font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);background:linear-gradient(100deg,var(--gold),var(--gold2));border-radius:99px;padding:14px 30px;text-decoration:none;transition:transform .25s,box-shadow .25s;box-shadow:0 10px 40px -12px rgba(240,196,100,.5)}
.forkhero:hover{transform:translateY(-3px) scale(1.02);box-shadow:0 18px 60px -12px rgba(240,196,100,.7)}
.forkhero .gh{font-size:18px}
.forksec{padding:90px 0 30px}
.forkcard{position:relative;display:block;text-decoration:none;color:inherit;background:linear-gradient(135deg,rgba(139,92,246,.14),rgba(21,14,38,.85) 45%,rgba(240,196,100,.1));border:1px solid rgba(167,139,250,.3);border-radius:28px;padding:clamp(36px,6vw,72px);text-align:center;overflow:hidden;transition:transform .35s,border-color .35s,box-shadow .35s}
.forkcard:hover{transform:translateY(-6px);border-color:var(--violet2);box-shadow:0 30px 90px -30px rgba(139,92,246,.5)}
.forkcard .fk{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.4em;text-transform:uppercase;color:var(--violet2);margin-bottom:22px}
.forkcard .fq{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(30px,5vw,58px);line-height:1.05;letter-spacing:-.01em;background:linear-gradient(100deg,var(--cream),var(--gold),var(--violet2));-webkit-background-clip:text;background-clip:text;color:transparent}
.forkcard .fa{font-family:'Fraunces',serif;font-style:italic;font-weight:300;color:var(--dim);font-size:clamp(15px,2vw,18px);margin-top:20px;max-width:640px;margin-left:auto;margin-right:auto}
.forkcard .fa b{color:var(--cream);font-weight:600;font-style:normal}
.forkbtns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:32px}
.forkbtns .fb{display:inline-flex;align-items:center;gap:10px;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;border-radius:99px;padding:13px 26px;transition:transform .25s,background .25s,color .25s}
.forkbtns .fb.solid{background:var(--gold);color:var(--ink)}
.forkbtns .fb.ghost{color:var(--violet2);border:1px solid rgba(167,139,250,.45)}
.forkcard:hover .fb.solid{transform:scale(1.04)}
.forkbtns .fb.ghost:hover{background:var(--violet2);color:var(--ink)}
.forkcard .fglow{position:absolute;top:-40%;left:50%;transform:translateX(-50%);width:70%;height:70%;background:radial-gradient(ellipse,rgba(139,92,246,.18),transparent 70%);pointer-events:none}
.stats{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:48px}
.stat{
  background:var(--card);border:1px solid var(--line);border-radius:16px;
  padding:16px 26px;backdrop-filter:blur(8px);min-width:150px;
}
.stat .n{font-family:'Fraunces',serif;font-weight:900;font-size:32px;color:var(--gold);line-height:1}
.stat .l{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-top:6px}
.scrolldown{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);color:var(--dim);font-size:22px;animation:bob 2.2s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,10px)}}

/* ---------- NAV ---------- */
nav{position:sticky;top:0;z-index:50;background:rgba(7,5,14,.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;gap:8px;overflow-x:auto;padding-top:10px;padding-bottom:10px}
nav .brand{font-family:'Fraunces',serif;font-weight:900;color:var(--gold);font-size:17px;white-space:nowrap;margin-right:14px}
nav a.nl{color:var(--dim);text-decoration:none;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap;padding:6px 12px;border-radius:99px;transition:.25s}
nav a.nl:hover{color:var(--ink);background:var(--gold)}

/* ---------- SECTIONS ---------- */
section.cluster{padding:90px 0 30px}
.cluster-head{display:flex;align-items:baseline;gap:18px;flex-wrap:wrap;margin-bottom:8px}
.cluster-head h2{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(30px,4.5vw,46px);color:var(--cream)}
.cluster-head .glyph{font-size:clamp(28px,4vw,40px)}
.cluster-sub{color:var(--dim);font-size:15px;max-width:680px;margin-bottom:40px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:22px}

.card{
  position:relative;background:var(--card);border:1px solid var(--line);border-radius:20px;
  padding:28px 26px 24px;backdrop-filter:blur(8px);
  transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .35s,box-shadow .35s;
  opacity:0;transform:translateY(28px);
}
.card.in{opacity:1;transform:translateY(0)}
.card:hover{transform:translateY(-6px);border-color:var(--ac,var(--gold));box-shadow:0 18px 50px -18px var(--ac,var(--gold))}
.card .star{position:absolute;top:20px;right:22px;width:9px;height:9px;border-radius:50%;background:var(--ac,var(--gold));box-shadow:0 0 14px 3px var(--ac,var(--gold));animation:twinkle 3s ease-in-out infinite}
@keyframes twinkle{0%,100%{opacity:.55}50%{opacity:1}}
.card .kicker{font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.25em;text-transform:uppercase;color:var(--ac,var(--gold));margin-bottom:10px}
.card h3{font-family:'Fraunces',serif;font-weight:600;font-size:23px;line-height:1.15;margin-bottom:10px;color:var(--cream)}
.card .essence{font-family:'Fraunces',serif;font-style:italic;font-weight:300;font-size:15.5px;color:var(--dim);margin-bottom:16px}
.card .quote{
  border-left:2px solid var(--ac,var(--gold));padding:4px 0 4px 14px;
  font-size:13.5px;color:var(--cream);opacity:.85;font-style:italic;margin-bottom:16px;
}
.summary{
  background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);border-radius:12px;
  padding:12px 14px;font-size:13px;color:var(--dim);line-height:1.55;margin-bottom:16px;
}
.summary b{display:block;font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.25em;color:var(--ac,var(--gold));margin-bottom:5px;font-weight:600}
.summary em{font-style:normal;font-weight:700;color:var(--cream)}
.chips{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:18px}
.chip{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--cream);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);border-radius:99px;padding:4px 11px}
.card a.go{
  display:inline-flex;align-items:center;gap:8px;text-decoration:none;
  font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--ac,var(--gold));transition:gap .25s;
}
.card a.go:hover{gap:14px}
.card a.alt{display:block;margin-top:8px;font-size:12px;color:var(--dim);text-decoration:none}
.card a.alt:hover{color:var(--gold)}
.card .live{display:inline-flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#7ee2a8;margin-bottom:14px}
.card .live::before{content:'';width:6px;height:6px;border-radius:50%;background:#7ee2a8;box-shadow:0 0 8px #7ee2a8}
.card .stale{color:#ffd43b}
.card .stale::before{background:#ffd43b;box-shadow:0 0 8px #ffd43b}

/* ---------- THREADS ---------- */
.threads{padding:90px 0}
.threads h2{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(30px,4.5vw,46px);margin-bottom:8px}
.threads .cluster-sub{margin-bottom:36px}
.thread{
  display:flex;gap:18px;align-items:flex-start;
  background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px 24px;margin-bottom:16px;
  opacity:0;transform:translateY(20px);transition:.5s;
}
.thread.in{opacity:1;transform:none}
.thread .tg{font-size:26px;line-height:1.2}
.thread h4{font-family:'Fraunces',serif;font-size:18px;color:var(--gold);margin-bottom:4px}
.thread p{font-size:14px;color:var(--dim)}
.thread p b{color:var(--cream);font-weight:500}

/* ---------- ORBIT ---------- */
.orbit{padding:40px 0 90px}
.orbit-track{display:flex;gap:0;flex-wrap:wrap;margin-top:36px}
.stop{flex:1;min-width:220px;border-top:2px solid var(--line);padding:22px 18px 0;position:relative}
.stop::before{content:'';position:absolute;top:-7px;left:18px;width:12px;height:12px;border-radius:50%;background:var(--gold);box-shadow:0 0 12px var(--gold)}
.stop .when{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}
.stop h4{font-family:'Fraunces',serif;font-size:20px;margin:8px 0 6px}
.stop p{font-size:13px;color:var(--dim)}

/* ---------- FEATURE: QUOTE OF THE NEW ECONOMY ---------- */
.feature{padding:100px 0 30px}
.feature a.fcard{
  display:block;text-decoration:none;position:relative;overflow:hidden;
  background:linear-gradient(135deg,rgba(240,196,100,.10),rgba(139,92,246,.10) 55%,rgba(255,138,92,.08));
  border:1px solid rgba(240,196,100,.35);border-radius:28px;
  padding:clamp(40px,7vw,80px) clamp(28px,6vw,72px);text-align:center;
  transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s,border-color .4s;
}
.feature a.fcard:hover{transform:translateY(-6px) scale(1.005);border-color:var(--gold);box-shadow:0 30px 90px -30px rgba(240,196,100,.45)}
.feature .fk{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.4em;text-transform:uppercase;color:var(--gold);margin-bottom:26px}
.feature .fq{
  font-family:'Fraunces',serif;font-weight:900;letter-spacing:-.02em;line-height:1.02;
  font-size:clamp(44px,8.5vw,104px);
  background:linear-gradient(100deg,var(--gold) 5%,var(--coral) 50%,var(--violet2) 95%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.feature .fq .bang{font-size:.5em;vertical-align:.35em}
.feature .fa{font-family:'Fraunces',serif;font-style:italic;font-weight:300;color:var(--dim);font-size:clamp(15px,2vw,19px);margin-top:24px}
.feature .fa b{color:var(--cream);font-weight:600;font-style:normal}
.feature .fgo{display:inline-flex;align-items:center;gap:10px;margin-top:34px;font-size:14px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(240,196,100,.4);border-radius:99px;padding:12px 26px;transition:gap .3s,background .3s,color .3s}
.feature a.fcard:hover .fgo{gap:18px;background:var(--gold);color:var(--ink)}
.feature .fglow{position:absolute;top:-40%;left:50%;transform:translateX(-50%);width:70%;height:70%;background:radial-gradient(ellipse,rgba(240,196,100,.16),transparent 70%);pointer-events:none}

/* ---------- LETTERS ---------- */
.arc{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-bottom:22px}
.step{position:relative;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px 22px;backdrop-filter:blur(8px)}
.step .num{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.3em;color:var(--gold);margin-bottom:10px}
.step h4{font-family:'Fraunces',serif;font-size:19px;color:var(--cream);margin-bottom:8px}
.step p{font-size:13.5px;color:var(--dim)}
.step p b{color:var(--cream);font-weight:500}
.step .arrow{position:absolute;top:22px;right:20px;color:var(--violet2);font-size:18px}
.pblock{background:linear-gradient(135deg,rgba(240,196,100,.08),rgba(21,14,38,.85) 50%,rgba(139,92,246,.10));border:1px solid rgba(240,196,100,.28);border-radius:22px;padding:clamp(26px,4vw,44px);margin-bottom:36px}
.pblock .pk{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.35em;text-transform:uppercase;color:var(--gold);margin-bottom:16px}
.pblock .pfull{font-family:'Fraunces',serif;font-style:italic;font-weight:300;font-size:clamp(16px,2.2vw,20px);color:var(--cream);line-height:1.65;max-width:920px}
.pblock .pfull b{color:var(--gold);font-weight:600;font-style:normal}
.pvars{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-top:22px}
.pvar{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:16px 18px}
.pvar .vl{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.25em;color:var(--violet2);margin-bottom:8px}
.pvar p{font-size:12.5px;color:var(--dim);line-height:1.6}
.sig{margin-top:22px;font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--cream);border-top:1px dashed rgba(240,196,100,.25);padding-top:16px}
.sig a{color:var(--gold);text-decoration:none}
.sig a:hover{text-decoration:underline}

/* ---------- LETTERS ARCHIVE ---------- */
.shelf{display:flex;flex-direction:column;gap:12px;margin-top:8px}
.letter{display:grid;grid-template-columns:56px 1fr auto;gap:18px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 22px;backdrop-filter:blur(8px);text-decoration:none;transition:transform .3s,border-color .3s,box-shadow .3s,opacity .6s;opacity:0;transform:translateY(18px)}
.letter.in{opacity:1;transform:none}
a.letter:hover{transform:translateX(6px);border-color:rgba(240,196,100,.4);box-shadow:0 8px 30px rgba(240,196,100,.08)}
.letter .seal{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:25px;background:rgba(240,196,100,.08);border:1px solid rgba(240,196,100,.22)}
.letter h4{font-family:'Fraunces',serif;font-size:18px;color:var(--cream);margin-bottom:5px}
.letter .one{font-size:13px;color:var(--dim);line-height:1.55}
.letter .one b{color:var(--cream);font-weight:500}
.letter .lst{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;padding:7px 13px;border-radius:99px;white-space:nowrap}
.letter .lst.incanon{color:var(--gold);border:1px solid rgba(240,196,100,.4)}
.letter .lst.wild{color:#7ee2a8;border:1px solid rgba(126,226,168,.35)}
.letter .lst.incoming{color:var(--violet2);border:1px solid rgba(167,139,250,.45);animation:shelfpulse 2.4s ease-in-out infinite}
.letter .lst.held{color:#ff9d7a;border:1px solid rgba(255,157,122,.5)}
@keyframes shelfpulse{0%,100%{opacity:.55}50%{opacity:1}}
@media(max-width:640px){.letter{grid-template-columns:44px 1fr}.letter .seal{width:44px;height:44px;font-size:20px}.letter .lst{grid-column:2;justify-self:start}}

/* ---------- FOOTER ---------- */
footer{border-top:1px solid var(--line);padding:70px 0 50px;text-align:center}
footer .big{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(26px,4vw,40px);background:linear-gradient(100deg,var(--gold),var(--coral),var(--violet2));-webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:14px}
footer .canon{color:var(--dim);font-size:13.5px;max-width:620px;margin:0 auto 8px}
footer .fine{font-family:'JetBrains Mono',monospace;font-size:11px;color:#5c5378;margin-top:26px;letter-spacing:.06em}
footer a{color:var(--gold);text-decoration:none}
footer a:hover{text-decoration:underline}
@media(max-width:640px){.grid{grid-template-columns:1fr}.stat{min-width:44%}}
/* 🌺 THE OHANA CORNER + 🔄🧲 CIRCULARITY MAGNET — family canon components (Admiral 2026-07-30 filing, grafted byte-faithful from twelve-dreams) */
#oflo{position:fixed;top:10px;left:10px;z-index:9999;width:40px;height:40px;border-radius:50%;background:rgba(20,18,45,.85);border:1px solid rgba(255,158,198,.5);display:flex;align-items:center;justify-content:center;font-size:19px;cursor:pointer;opacity:.55;transition:opacity .3s;user-select:none}#oflo:hover{opacity:1}
#oflop{display:none;position:fixed;top:56px;left:10px;z-index:9999;width:min(320px,86vw);max-height:72vh;overflow-y:auto;background:rgba(12,11,28,.97);border:1px solid rgba(255,158,198,.4);border-radius:16px;padding:18px;font-family:Georgia,serif;color:#e8e6ff;box-shadow:0 10px 40px rgba(0,0,0,.6)}#oflop.open{display:block}
#oflop h4{font-weight:normal;letter-spacing:3px;font-size:13px;color:#ff9ec6;margin:14px 0 8px}#oflop h4:first-child{margin-top:0}
#oflop .od{display:flex;align-items:center;gap:8px;color:#cfc9ee;text-decoration:none;font-size:12px;padding:3px 6px;border-radius:8px;font-family:'Courier New',monospace}#oflop .od:hover{background:rgba(255,158,198,.1);color:#fff}
#oflop .oa{display:inline-flex;align-items:center;gap:5px;font-size:11px;color:#cfc9ee;padding:3px 7px;margin:2px;background:rgba(180,140,255,.08);border-radius:12px}
#oflop .chat{margin-top:16px;border-top:1px solid rgba(255,158,198,.25);padding-top:14px}
#oflop .chat input{width:100%;background:rgba(0,0,0,.4);border:1px solid rgba(255,158,198,.35);border-radius:20px;color:#e8e6ff;padding:9px 14px;font-family:Georgia,serif;font-size:12px;box-sizing:border-box}
#oflop .chat .soon{color:#9d97c9;font-size:11px;font-style:italic;margin-top:7px;text-align:center}
#oflop .x{position:absolute;top:8px;right:12px;cursor:pointer;color:#9d97c9;font-size:14px}

#cmag{position:fixed;top:10px;right:10px;z-index:9999;width:40px;height:40px;border-radius:50%;background:rgba(20,18,45,.85);border:1px solid rgba(124,211,255,.4);display:flex;align-items:center;justify-content:center;font-size:17px;cursor:pointer;opacity:.55;transition:opacity .3s;user-select:none}#cmag:hover{opacity:1}
#cmag{position:fixed;top:10px;right:10px;z-index:9999;width:40px;height:40px;border-radius:50%;background:rgba(20,18,45,.85);border:1px solid rgba(124,211,255,.4);display:flex;align-items:center;justify-content:center;font-size:17px;cursor:pointer;opacity:.55;transition:opacity .3s;user-select:none}#cmag:hover{opacity:1}
#cmagb{display:none;position:fixed;top:56px;right:10px;z-index:9999;width:250px;background:rgba(12,11,28,.97);border:1px solid rgba(124,211,255,.35);border-radius:14px;padding:16px;font-family:Georgia,serif;color:#e8e6ff;font-size:12.5px;line-height:1.7;box-shadow:0 8px 30px rgba(0,0,0,.5)}#cmagb.open{display:block}
#cmagb .ens{color:#7ee2a0;font-family:'Courier New',monospace;font-size:14px}#cmagb .a{font-family:'Courier New',monospace;font-size:9.5px;color:#8fd0ff;word-break:break-all;margin:6px 0}
#cmagb button{background:#2b5aa8;border:none;color:#fff;font-size:11px;padding:6px 14px;border-radius:16px;cursor:pointer;letter-spacing:1px}
#cmagb .x{position:absolute;top:6px;right:10px;cursor:pointer;color:#9d97c9;font-size:13px}
#cmagb .pool{display:block;margin-top:9px;color:#7cd3ff;font-size:11px;letter-spacing:1px;text-decoration:none}
#cmagb .stripe{color:#fbe2a0;font-size:11px;margin-top:8px;font-style:italic}
</style>
</head>
