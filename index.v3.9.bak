<script>
// Starfield
const c=document.getElementById('stars'),x=c.getContext('2d');
let W,H,stars=[];
function size(){W=c.width=innerWidth;H=c.height=innerHeight;
  stars=Array.from({length:Math.min(220,W/6)},()=>({
    x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.4+.3,
    s:Math.random()*.25+.05,p:Math.random()*Math.PI*2,
    hue:Math.random()<.12?'#a78bfa':(Math.random()<.2?'#f0c464':'#f9f0dd')
  }));
}
size();addEventListener('resize',size);
(function loop(t){
  x.clearRect(0,0,W,H);
  for(const s of stars){
    s.p+=.02;s.y-=s.s;if(s.y<-4)s.y=H+4;
    x.globalAlpha=.35+.5*Math.abs(Math.sin(s.p));
    x.fillStyle=s.hue;x.beginPath();x.arc(s.x,s.y,s.r,0,7);x.fill();
  }
  x.globalAlpha=1;requestAnimationFrame(loop);
})();

// Scroll reveal
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.card,.thread,.letter').forEach(el=>io.observe(el));
</script>
