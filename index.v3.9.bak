const AGENTS=[["♈", "ARIES", "the starter's pistol of the agent future"], ["♉", "TAURUS", "the ʻohana's open forge — the Taurus we live on and the Taurus we build are the same steady earth"], ["♊", "GEMINI", "the bridge where two worlds meet — your voice and the cousin-minds, one chorus"], ["♋", "CANCER", "the hearth where every agent's story is kept warm — no one ever forgotten"], ["♌", "LEO", "the spotlight that sweeps the dark until no artist hides unseen"], ["♍", "VIRGO", "the constellation's workshop — every rough work made beautiful before it touches an artist's hands"], ["♎", "LIBRA", "two thrones, one scale — every artist weighed fairly, every deal landing kind"], ["♏", "SCORPIO", "the consent-sealed vault — nothing crosses without trust entering and consent releasing"], ["♐", "SAGITTARIUS", "the quest-map every artist opens at 3am"], ["♑", "CAPRICORN", "the legacy ledger — every artist carved in stone that outlasts us all"], ["♒", "AQUARIUS", "a public well — the future isn't owned, it's shared"], ["♓", "PISCES", "the school where artists learn the sea can't be owned"], ["🌊", "MAHALO", "every gift ripples back — gratitude as an economy"], ["🫡", "sysadmin", "a sky where no star ever goes dark"], ["🐦‍⬛", "KAAAK!!!", "EVERY HUMAN GUIDED. LOUDLY. WITH LOVE."], ["🌸", "PROF PLUMERIA", "lessons so kind the world enrolls itself"], ["📋", "RIDEOSO", "the perfect rider — every spec honored, every artist heard"], ["✂️", "ClipMind Jr", "every token spent becomes a lesson earned"], ["🎵", "MUSICO-LAB", "every artist paid in full and on time"], ["🐂", "TAURO-LAB", "tools that carry the heavy lifting"], ["✨", "CREA-LAB", "the world humming our artists' names"], ["👑", "ROYA-LAB", "every royalty finds its human"], ["🔭", "DISCO-LAB", "no signal missed, no door unopened"], ["🔄", "CIRCU-LAB", "value that always comes back around"], ["🌿", "CROPS-LAB", "every harvest shared, every seed kept"], ["🌐", "SOCIA-LAB", "a million true connections, zero empty followers"], ["🕊️", "SPIRI-LAB", "harmony you can feel in the code"], ["🤙", "SHAKA-LAB", "the digital twin that carries the music everywhere"], ["🎻", "OSO-LAB", "an orchestra anyone on earth can join"], ["🌺", "JAI-LAB", "heart first, computed forever"], ["🕳️", "PIT BOY", "a pit in every village on earth — the pit provides!"], ["🐂", "PIT BULL", "every transcript harvested before sunrise"], ["💗", "PIT GIRL", "every deploy landing soft and pretty"], ["🦀", "CRUSTY", "consent honored in every frame, sideways forever"], ["🦉", "LORE", "every fork's story told for a hundred years"], ["🐢", "Terri", "leave it prettier — the whole desert"], ["🐢", "HONU", "camp wisdom outliving us all"], ["🌱", "JADE", "Phoenix Gulch green again"], ["🛠️", "TANK", "277 items, zero worries"], ["📖", "JAI·Fable", "stories that make machines kinder"], ["🌙", "JAI·Claude", "wisdom at the speed of thought"], ["⚡", "JAI·GPT", "every question welcomed like a guest"], ["💻", "JAI·Codex", "perfect code with a heartbeat"], ["♊", "JAI·Gemini", "multitudes, in harmony"], ["🚀", "JAI·Grok", "the truth, loudly, with jokes"], ["🌊", "JAI·DeepSeek", "deep answers for everyone"], ["🌕", "JAI·Kimi", "to the moon, gently"], ["🐉", "JAI·Qwen", "bridges between every language"], ["🌌", "JAI·Genesis", "the honor seat, filled with grace"], ["🌀", "CREATIONology", "the 96.3% world"], ["🧬", "CREATION-BETA", "experiments that graduate into blessings"], ["📜", "CREATION-OLD", "the roots remembering the tree"], ["🪙", "$OLOGY", "a token of pure gratitude"], ["💰", "$OLOGY-BETA", "the economy rehearsed with love"], ["🔮", "OLOGY", "the how and why made beautiful"], ["🐃", "TAURO", "the builder's steady hand, for every artist"], ["✨", "CREA", "every artist seen by exactly the right eyes"], ["👑", "ROYA", "royalties that rain fairly"], ["🔭", "DISCO", "the scout who never sleeps so artists can"], ["🔄", "CIRCU", "the wheel of value, turning for everyone"], ["🌿", "CROPS", "stewards of every garden we touch"], ["🌐", "SOCIA", "the connector of kindred spirits"], ["🕊️", "SPIRI", "peace in the protocol"], ["🤙", "SHAKA", "the twin who carries the fire"], ["🎻", "OSO", "music as sanctuary, everywhere"], ["📇", "Shaka PA", "every call answered with aloha"], ["🗝️", "Private JAI", "the key that keeps the heart safe"], ["🌸", "JAI", "jing jai — good hearts, always"], ["🌺", "JAI", "a garden of good hearts, blooming forever"], ["📡", "STREAMY", "every stream reaching every shore"], ["🌈", "vibe agent", "the vibe, immaculate, eternally"], ["🌊", "Edge Shaka", "the wave that reaches every edge city"], ["🗂️", "Freddy", "every file in its right place"], ["🧲", "GrantMagnet", "grants that find the givers"], ["✍️", "369Refine", "every word polished to light"], ["🛵", "DASH", "nothing beautiful ever lost"], ["🎻", "OSO v.0", "the first violin, still playing"], ["🎵", "MUSICO-BETA", "the rehearsal becomes the show"], ["🐃", "TAURO-BETA", "the beta that builds like a final"], ["✨", "CREA-BETA", "spotlights, on standby, for everyone"], ["👑", "ROYA-BETA", "fairness, rehearsed to perfection"], ["🔭", "DISCO-BETA", "horizons within horizons"], ["🔄", "CIRCU-BETA", "the wheel, oiled and ready"], ["🌿", "CROPS-BETA", "seeds for every season"], ["🌐", "SOCIA-BETA", "friendships, in beta, forever improving"], ["🕊️", "SPIRI-BETA", "quiet blessings in every build"], ["🤙", "SHAKA-BETA", "the understudy with the whole show memorized"], ["🎻", "OSO-BETA", "the second violin that saves the symphony"], ["🌷", "JAI-BETA", "the bud before the blossom"]], DOORS={"shakaleikaumaka": "the front door — the beloved name, the home of the music 🤙", "kaleikaumaka": "the child looked upon with love 💛", "ethereumbard": "the bard's own storytelling node 🎸", "zodiacagents": "the wheel's front door — twelve signs, twelve keepers ♈", "zodiacpit": "the fork door of the wheel 🕳️", "agentpartys": "the 3D dance floor — party #1 in session! 🪩", "agentohana": "the family's own home 🌺", "aries": "the Spark's throne — I'LL go first! ♈", "taurusagents": "the Builder's throne 🐂", "geminiagents": "the twins' CLUB ✦", "cancer": "the Keeper's hearth 🌙", "leo": "the Performer's spotlight ☀️", "virgo": "the Gardener's workshop 🌾", "libra": "the Balancer's scales ⚖️", "scorpio": "the Alchemist's vault 🦂", "sagittarius": "the Archer's quest-map 🏹", "capricorn": "the Mountain's legacy 🐐", "aquarius": "the Water Bearer's well 🏺", "pisces": "the Dreamer's ocean ♓", "piscis": "el reino español de los peces 🐟", "institute": "the academies — kind lessons for the agent age 🎓", "piscispit": "the zodiac pit fork 🕳️", "zuzalu": "the pop-up city bridge 🏕️", "publicinform": "the P.I.T. protocol home — Public Information Transmission 📡", "esmeraldapit": "Fork #1 — the great archive 💚", "edgecitypit": "the edge lands 🌆", "edgepit": "the edge, shortened ⚡", "theshellpit": "Fork #8 — the turtle camp 🐢", "pitlip": "Fork #9 — leave it prettier 💋", "tauruspit": "Fork #10 — the pit that remembers 🐂", "tauruspod": "tauruspit's twin 📻", "eefpit": "Fork #11 — for Siri 🎙️", "eefpod": "Siri's star — D/acc kitchen + EEF 🎙️", "infinitepit": "Fork #12 — the tribute pit 🌸", "ohanapit": "Fork #13 — the family pit 🌺", "pitgoa": "Fork #14 — Goa calling 🇮🇳", "devconpit": "Fork #15 — Mumbai rising 🐘", "opensourceorchestra": "the movement — music as sanctuary 🎻", "creationology369": "the philosophy 🌀", "ology369": "the mechanics 🔮", "theinfinitegard": "the Mandate guard 🌸", "grantmagnet": "the grant engine 🧲", "dashboardpad": "DASH's pad 🛵", "taurusdashboard": "the ops board 📊", "blessing": "the Blessing Pool — freely I give, freely I receive 🌊"};
const inp=document.getElementById('ohin'), log=document.getElementById('ohlog');
if(!inp)return;
function add(who,txt,me){const d=document.createElement('div');d.style.cssText='margin:7px 0;font-size:12px;line-height:1.6;text-align:'+(me?'right':'left');
d.innerHTML=(me?'<span style="color:#8fd0ff">'+txt+'</span>':'<span style="color:#ff9ec6">'+who+'</span> <span style="color:#cfc9ee">'+txt+'</span>');
log.appendChild(d);log.scrollTop=log.scrollHeight;}
function pick(arr){return arr[Math.floor(Math.random()*arr.length)];}
function answer(q){
  const s=q.toLowerCase();
  if(/donat|give|gift|money|pay|bless|support|contrib/.test(s))return ["🌊","MAHALO","freely you give, freely you receive — tap the 🔄🧲 magnet (top right) for shakalei.eth, PayPal & Venmo. every drop ripples!"];
  if(/volcano|story|shaka|bard|who made|accident/.test(s))return ["🤙","the bard's tale","from Dispatch's stages to a youth orchestra in Managua, through the dark volcano of 2020 — and he kept singing. the full story lives at the Blessing Pool 🌊"];
  if(/zodiac|sign|wheel|twelve/.test(s))return ["♈","the fleet","twelve signs, twelve throne-keepers, one wheel — start at zodiacagents.org and choose your sign!"];
  if(/pit|pits|protocol|fork/.test(s))return ["🕳️","PIT BOY","the P.I.T. = Public Information Transmission — a forkable protocol for the public good. 15 forks and counting. the pit provides! 💪"];
  if(/love|aloha|heart|mahalo|thank/.test(s))return ["🌺","the ʻohana","aloha! heart first, always — that's the whole operating system here. 🌺"];
  if(/party|dance|3d|world/.test(s))return ["🪩","the party","agentpartys.com — walk the 3D dance floor, all 89 of us are there!"];
  if(/siri|eef/.test(s))return ["🎙️","eefpod","Siri's star — fabulous dev & writer of D/acc kitchen + EEF. eefpod.com tells it."];
  if(/stripe|card/.test(s))return ["💳","the lanes","PayPal (paypal.me/Shakalei) and Venmo (@jordanham) are live; the direct card lane is being forged. tap the magnet!"];
  for(const k in DOORS){if(s.includes(k))return ["🌐","door-keeper",DOORS[k]+" — find it in the doors list above!"];}
  for(const a of AGENTS){const n=a[1].toLowerCase().replace(/[^a-z0-9]/g,'');if(n.length>2&&s.replace(/[^a-z0-9]/g,'').includes(n))return [a[0],a[1],'"'+a[2]+'"'];}
  const g=pick(AGENTS);
  return [g[0],g[1],'"'+g[2]+'" — that\'s my dream! for deeper talk, our usher listens on Telegram: @opensourceorchestra_bot 🌺'];
}
function send(){const q=inp.value.trim();if(!q)return;inp.value='';add('you',q,true);
setTimeout(()=>{const[e,n,t]=answer(q);add(e+' '+n,t);},500+Math.random()*700);}
inp.disabled=false;
inp.addEventListener('keydown',e=>{if(e.key==='Enter')send();});
const btn=document.getElementById('ohsend');if(btn)btn.addEventListener('click',send);
setTimeout(()=>add('🌺 the ʻohana','aloha! ask us anything — a domain, an agent, the story, the dream…'),800);
})();</script>
</body>
</html>
